<% layout("/layouts/boilerplate") %>

<!-- Modern CSS for Login (Dark Luxury + Emerald Pop) -->
<style>
    :root {
        /* Theme Variables */
        --primary-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); /* Emerald Pop */
        --dark-gradient: linear-gradient(135deg, #232526 0%, #414345 100%); /* Midnight City */
        --primary-color: #11998e;
        --bg-color: #eef2f3; /* Very light gray/blue tint */
    }

    .login-container {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bg-color);
    }
    
    .login-card {
        border: none;
        border-radius: 1.5rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        background: #fff;
        overflow: hidden;
        transition: transform 0.3s ease;
    }
    
    .login-card:hover {
        transform: translateY(-5px);
    }

    /* DARK HEADER - Matches Navbar better */
    .login-header {
        background: var(--dark-gradient);
        padding: 3rem 2rem;
        text-align: center;
        color: white;
        position: relative;
    }
    
    /* Decorative curve */
    .login-header::after {
        content: '';
        position: absolute;
        bottom: -25px;
        left: 0;
        width: 100%;
        height: 50px;
        background: #fff;
        border-radius: 50% 50% 0 0 / 100% 100% 0 0;
        transform: scaleX(1.3);
    }

    /* Icon Gradient Effect */
    .header-icon {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(17, 153, 142, 0.25);
        border-color: var(--primary-color);
    }

    /* Emerald Button for High Contrast */
    .btn-theme {
        background: var(--primary-gradient);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-theme:hover {
        background: linear-gradient(135deg, #0e857b 0%, #2dd86e 100%);
        color: white;
        box-shadow: 0 8px 20px rgba(17, 153, 142, 0.4);
        transform: translateY(-2px);
    }

    .eye-btn {
        background: white;
        color: #6c757d;
        border-left: none;
        z-index: 10;
    }
    .eye-btn:hover {
        color: var(--primary-color);
        background: #f8f9fa;
    }
</style>

<div class="login-container">
    <div class="col-md-5 col-lg-4">
        <div class="card login-card">
            
            <!-- Dark Header -->
            <div class="login-header">
                <div class="mb-2">
                    <!-- Gradient Icon -->
                    <i class="fas fa-graduation-cap fa-3x header-icon"></i>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="small text-white-50 mb-0">Login to continue selling</p>
            </div>

            <div class="card-body p-4 p-md-5 pt-4"> 
                <form action="/login" method="POST" class="needs-validation" novalidate>
                    
                    <!-- Username -->
                    <div class="mb-4 mt-3">
                        <label class="form-label text-muted small fw-bold text-uppercase tracking-wide">Username</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-user"></i></span>
                            <input 
                                type="text" 
                                name="username" 
                                class="form-control bg-light border-start-0 fs-6" 
                                placeholder="Enter your username"
                                required 
                                autofocus
                            />
                        </div>
                    </div>

                    <!-- Password with Eye Icon -->
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase tracking-wide">Password</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                            <input 
                                type="password" 
                                name="password" 
                                id="password" 
                                class="form-control bg-light border-start-0 border-end-0 fs-6" 
                                placeholder="Enter your password"
                                required 
                            />
                            <!-- The Eye Button -->
                            <button class="btn btn-light border border-start-0 text-muted eye-btn" type="button" onclick="togglePasswordVisibility('password', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 mt-5">
                        <button class="btn btn-theme btn-lg fw-bold" type="submit">
                            LOGIN NOW
                        </button>
                    </div>
                    
                    <div class="mt-4 text-center">
                        <p class="text-muted small mb-2">New to QuickSell?</p>
                        <a href="/signup" class="btn btn-outline-dark btn-sm rounded-pill px-4 fw-bold">Create Verified Account</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Password Toggle Logic
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = "password";
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Validation
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>