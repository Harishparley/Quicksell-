<% layout("/layouts/boilerplate") %>

<!-- CSS for the 'Shake' animation on error -->
<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
    20%, 40%, 60%, 80% { transform: translateX(4px); }
  }
  .shake { animation: shake 0.4s ease-in-out; }
  
  /* Status Colors */
  .valid-domain { border-color: #198754 !important; box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25) !important; }
  .invalid-domain { border-color: #dc3545 !important; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important; }
</style>

<div class="row mt-5">
  <div class="col-6 offset-3">
    <!-- Header -->
    <div class="text-center mb-4">
      <h2 class="fw-bold">Welcome Back!</h2>
      <p class="text-muted">Login to your QuickSell Student Account</p>
    </div>

    <form action="/login" method="POST" id="loginForm" class="needs-validation" novalidate>
      
      <!-- College Email Field -->
      <div class="mb-3">
        <label for="email" class="form-label fw-bold">College Email</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-envelope"></i></span>
          <input 
            type="email" 
            name="username" 
            id="email" 
            class="form-control" 
            placeholder="rollnumber@yourcollege.edu"
            required 
            autofocus
          />
        </div>
        <!-- Feedback Messages -->
        <div id="emailHelp" class="form-text text-muted">Must be a valid @yourcollege.edu email.</div>
        <div class="invalid-feedback">Please provide a valid college email.</div>
      </div>

      <!-- Password Field -->
      <div class="mb-3">
        <label for="password" class="form-label fw-bold">Password</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-lock"></i></span>
          <input 
            type="password" 
            name="password" 
            id="password" 
            class="form-control" 
            placeholder="Enter your password"
            required 
          />
        </div>
      </div>
      
      <button class="btn btn-success w-100 py-2 fw-bold" type="submit" id="loginBtn">Login</button>
      
      <div class="mt-3 text-center">
        <small>Don't have an account? <a href="/signup" class="text-decoration-none">Register here</a></small>
      </div>
    </form>
  </div>
</div>

<script>
  // CONFIGURATION: Set your college domain here
  const COLLEGE_DOMAIN = 'yourcollege.edu'; // e.g., 'lnct.ac.in' or 'rgpv.ac.in'

  const emailInput = document.getElementById('email');
  const loginForm = document.getElementById('loginForm');
  const emailHelp = document.getElementById('emailHelp');

  // 1. Real-time Validation Listener
  emailInput.addEventListener('input', function(e) {
      const email = e.target.value.toLowerCase();
      
      // Reset if empty
      if (email.length === 0) {
          emailInput.classList.remove('valid-domain', 'invalid-domain');
          emailHelp.className = 'form-text text-muted';
          emailHelp.innerText = 'Must be a valid @' + COLLEGE_DOMAIN + ' email.';
          return;
      }

      // Check Domain
      if (email.endsWith('@' + COLLEGE_DOMAIN)) {
          // Success State
          emailInput.classList.remove('invalid-domain');
          emailInput.classList.add('valid-domain');
          emailHelp.className = 'form-text text-success';
          emailHelp.innerHTML = '<i class="fas fa-check-circle"></i> Valid College Email';
      } else {
          // Error State (only show red if they've typed an '@' already)
          if(email.includes('@')) {
              emailInput.classList.remove('valid-domain');
              emailInput.classList.add('invalid-domain');
              emailHelp.className = 'form-text text-danger';
              emailHelp.innerText = 'Email must end with @' + COLLEGE_DOMAIN;
          }
      }
  });

  // 2. Prevent Submission if Domain is Wrong
  loginForm.addEventListener('submit', function(event) {
      const email = emailInput.value.toLowerCase();
      
      if (!email.endsWith('@' + COLLEGE_DOMAIN)) {
          event.preventDefault(); // STOP the form
          event.stopPropagation();
          
          // Shake animation for effect
          emailInput.classList.add('shake');
          emailInput.classList.add('is-invalid'); // Bootstrap error
          setTimeout(() => emailInput.classList.remove('shake'), 500);
          
          // Focus back on email
          emailInput.focus();
      }
  });
</script>