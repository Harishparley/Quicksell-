<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-md-8 offset-md-2">
    
    <div class="card shadow-lg border-0 rounded-3">
      <!-- CHANGED: Header is now standard and professional -->
      <div class="card-header bg-success text-white text-center py-4">
        <h3 class="mb-0 fw-bold"><i class="fas fa-shield-alt me-2"></i>Student Verification</h3>
        <p class="mb-0 text-white-50 small">Upload your College ID for instant approval.</p>
      </div>
      
      <div class="card-body p-4 bg-light">
        <form action="/signup" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
          
          <!-- Section 1: Basic Info -->
          <h5 class="text-secondary border-bottom pb-2 mb-3">1. Account Details</h5>
          
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Username</label>
              <input name="username" type="text" class="form-control" placeholder="Choose a username" required />
            </div>
            
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Email</label>
              <input name="email" type="email" class="form-control" placeholder="student@example.com" required />
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">Mobile Number</label>
              <input name="contact" type="number" class="form-control" placeholder="For buyers to contact you" required />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-bold">College Name</label>
              <input name="college" type="text" class="form-control" placeholder="e.g. LNCT Bhopal" required />
            </div>
          </div>

          <!-- Section 2: ID Verification -->
          <h5 class="text-secondary border-bottom pb-2 mb-3 mt-2">2. ID Verification</h5>
          
          <!-- CHANGED: Friendly message explaining WHY we need it -->
          <div class="alert alert-light border shadow-sm d-flex align-items-center" role="alert">
            <i class="fas fa-user-check text-success fa-lg me-3"></i>
            <div>
              <strong>Instant Verification:</strong> We match your <b>Enrollment Number</b> with your ID Card photo to ensure only real students join.
            </div>
          </div>

          <div class="mb-3">
             <label class="form-label fw-bold">Enrollment / Roll Number</label>
             <input name="enrollment" type="text" class="form-control form-control-lg text-uppercase" placeholder="EX: 0187CS191001" required />
          </div>

          <div class="mb-4">
            <label class="form-label fw-bold">Upload College ID (Front Side)</label>
            <input class="form-control" type="file" name="collegeIdImage" accept="image/*" required onchange="previewImage(event)">
            <div class="form-text">Photo must be clear and readable.</div>
            
            <div class="mt-3 text-center">
                <img id="cardPreview" src="#" alt="ID Preview" class="img-fluid rounded shadow-sm d-none" style="max-height: 200px; border: 2px dashed #adb5bd;">
            </div>
          </div>

          <!-- Section 3: Password -->
          <h5 class="text-secondary border-bottom pb-2 mb-3">3. Security</h5>
          <div class="mb-4">
            <label class="form-label fw-bold">Password</label>
            <input name="password" type="password" class="form-control" required />
          </div>

          <div class="d-grid gap-2">
            <!-- CHANGED: Button text is benefit-oriented -->
            <button class="btn btn-success btn-lg fw-bold" type="submit">
              Complete Registration
            </button>
          </div>
          
          <div class="text-center mt-3">
            <a href="/login" class="text-decoration-none">Already have an account? Login</a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
    function previewImage(event) {
        const input = event.target;
        const preview = document.getElementById('cardPreview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
    
    // Bootstrap validation
    (function () {
      'use strict'
      var forms = document.querySelectorAll('.needs-validation')
      Array.prototype.slice.call(forms).forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })
    })()
</script>