<style>
  .btn-search {
    background: linear-gradient(135deg, #FF4757, #FF6348);
    color: #fff;
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    border: none;
    box-shadow: 0 4px 15px rgba(255, 71, 87, 0.3);
    transition: all 0.3s ease;
  }
  .btn-search:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 71, 87, 0.4);
    color: white;
  }
  .btn-search i {
    display: inline;
    margin-left: 0.5rem;
  }
  .search-inp {
    border-radius: 50px;
    padding: 0.7rem 1.5rem;
    font-size: 0.9rem;
    background-color: #f1f2f6;
    border: 1px solid transparent;
  }
  .search-inp:focus {
    background-color: #fff;
    border-color: #FF4757;
    box-shadow: 0 0 0 4px rgba(255, 71, 87, 0.1);
  }
</style>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/products">
      <i class="fa-solid fa-graduation-cap"></i> Quick Sell
    </a>
    
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/products">Explore</a>
      </div>

      <!-- Search Bar -->
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search" action="/products" method="GET">
          <input 
            class="form-control me-2 search-inp" 
            type="search" 
            name="search"
            placeholder="Search books, gadgets..." 
            aria-label="Search"
          />
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>

      <!-- Auth Links -->
      <div class="navbar-nav ms-auto align-items-center gap-2">
        <a class="nav-link" href="/products/new">Sell Item</a>
        
        <% if(!currUser) { %>
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <a class="nav-link btn btn-search text-white px-3" href="/login">Log in</a>
        <% } else { %>
          <!-- THIS IS THE MISSING LINK -->
          <a class="nav-link fw-bold text-primary" href="/profile">
            <i class="fa-regular fa-circle-user"></i> My Profile
          </a>
          <a class="nav-link" href="/logout">Log out</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>