<style>
  /* Existing styles... */
  .btn-search {
    background: var(--primary-gradient) !important;
    color: #fff !important;
    border-radius: 50px !important;
    padding: 0.5rem 1.5rem !important;
    border: none !important;
    box-shadow: 0 4px 15px rgba(17, 153, 142, 0.3);
    transition: all 0.3s ease;
  }
  .btn-search:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(17, 153, 142, 0.4);
    color: white !important;
  }
  .search-inp {
    border-radius: 50px;
    padding: 0.7rem 1.5rem;
    font-size: 0.9rem;
    background-color: #f8f9fa;
    border: 1px solid transparent;
  }
  .search-inp:focus {
    background-color: #fff;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(17, 153, 142, 0.15);
  }
  
  /* NEW: Notification Badge */
  .notification-badge {
      position: absolute;
      top: 5px;
      right: 5px;
      width: 10px;
      height: 10px;
      background-color: #ff4757;
      border-radius: 50%;
      border: 2px solid white;
      display: none; /* Hidden by default */
      animation: pulse 2s infinite;
  }

  @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(255, 71, 87, 0.4); }
      70% { box-shadow: 0 0 0 10px rgba(255, 71, 87, 0); }
      100% { box-shadow: 0 0 0 0 rgba(255, 71, 87, 0); }
  }
</style>

<!-- Load Socket.io Client GLOBALLY -->
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>

<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/products">
      <i class="fa-solid fa-graduation-cap"></i> Quick Sell
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/products">Explore</a>
      </div>

      <!-- Search Bar -->
      <div class="navbar-nav mx-auto">
        <form class="d-flex" role="search" action="/products" method="GET">
          <input
            class="form-control me-2 search-inp"
            type="search"
            name="search"
            placeholder="Search books, gadgets..."
            aria-label="Search"
          />
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div>

      <!-- Right Side Links -->
      <div class="navbar-nav ms-auto align-items-center gap-2">
        
        <% if(!currUser) { %>
            <a class="nav-link" href="/signup"><b>Signup</b></a>
            <a class="nav-link btn btn-search text-white px-3" href="/login">Log in</a>
        <% } else { %>
            <a class="nav-link" href="/products/new">Sell Item</a>
            
            <!-- MESSAGES LINK WITH BADGE -->
            <a class="nav-link position-relative" href="/chat" id="messagesLink">
                <i class="fa-regular fa-comment-dots"></i> Messages
                <span class="notification-badge" id="msgBadge"></span>
            </a>
            
            <a class="nav-link fw-bold" href="/profile" style="color: var(--primary);">
                <i class="fa-regular fa-circle-user"></i> My Profile
            </a>
            <a class="nav-link" href="/logout">Log out</a>
        <% } %>
        
      </div>
    </div>
  </div>
</nav>

<!-- ALERT TOAST (Notification Popup) -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 11000">
  <div id="msgToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true" style="background: var(--primary-gradient); color: white;">
    <div class="d-flex">
      <div class="toast-body">
        <i class="fas fa-envelope me-2"></i> 
        <strong class="me-auto">New Message!</strong><br>
        <small id="toastSender">Check your inbox</small>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>

<!-- GLOBAL SOCKET LOGIC -->
<% if(currUser) { %>
<script>
    // 1. Initialize Socket
    const socket = io();
    const currentUserId = "<%= currUser._id %>";

    // 2. Join my personal room (so I can receive messages)
    socket.emit('join-chat', currentUserId);

    // 3. Listen for incoming messages GLOBALLY
    socket.on('receive-message', (data) => {
        // A. Show Red Dot Badge
        const badge = document.getElementById('msgBadge');
        if(badge) badge.style.display = 'block';

        // B. Play Notification Sound (Optional but cool)
        // const audio = new Audio('/sounds/notification.mp3');
        // audio.play();

        // C. Show Toast Popup
        const toastEl = document.getElementById('msgToast');
        const toastSenderEl = document.getElementById('toastSender');
        
        // If we are NOT already on the chat page, show notification
        if (!window.location.href.includes('/chat')) {
            toastSenderEl.innerText = "You have a new message";
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    });
</script>
<% } %>